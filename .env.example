# ---------------------------------------------------------
# MQTT Broker Configuration
# ---------------------------------------------------------
# Localhost when running broker locally via Docker/Mosquitto
# On physical edge devices, set this to the Broker/Host machine's IP (e.g., 192.168.1.50)
MQTT_BROKER_HOST=127.0.0.1

# Standard unencrypted MQTT port (matches compose.yml)
MQTT_BROKER_PORT=1883

# Network keep-alive in seconds
MQTT_KEEPALIVE_SEC=60

# ---------------------------------------------------------
# Topic Namespace Configuration
# ---------------------------------------------------------
# Root prefix for all sensor, alert, and status channels
FOREST_ROOT_TOPIC=forest
