# .env.example

# ---------------------------------------------------------
# MQTT Broker Configuration
# ---------------------------------------------------------
# For the central node running the broker locally, use 127.0.0.1.
# For edge nodes, change this to the Central Node's actual local IP (e.g., 192.168.1.50)
MQTT_BROKER_HOST=127.0.0.1

# Standard unencrypted MQTT port (matches the docker-compose.yml)
MQTT_BROKER_PORT=1883

# ---------------------------------------------------------
# Topic Configuration
# ---------------------------------------------------------
# The root topic for all presence sensors
MQTT_BASE_TOPIC=project/presence
